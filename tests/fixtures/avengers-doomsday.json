{"data":{"presentation":{"slug":"avengers-doomsday","legacySlug":null,"show":{"slug":"avengers-doomsday","legacySlug":null,"title":"Avengers: Doomsday","vistaHoCodes":["A000036614","A000036615","A000036716","A000036772"],"headline":"The gang's all here. We mean all of them.","description":"<p>Universes collide and the Multiverse Saga begins its final chapter in Marvel Studios' Avengers: Doomsday. Beloved heroes from three distinct universes will be set on a deadly collision course and ultimately face an existential threat unlike anything they've ever encountered. This epic film will lay the foundation for the future of the Marvel Cinematic Universe. See it in Infinity Vision, the way it's meant to be seen, on bigger, brighter, and more immersive screens.</p>","landscapeHeroImage":{"uri":"https://img-assets.drafthouse.com/images/shows/avengers-doomsday/AVENGERS-DOOMSDAY_hero-temp.jpg?auto=compress&crop=focalpoint&fit=crop&fp-x=0.5&fp-y=0.5&h=1080&q=80&w=1920","altText":"AVENGERS: DOOMSDAY"},"portraitHeroImage":{"uri":"https://img-assets.drafthouse.com/images/shows/avengers-doomsday/AVENGERS-DOOMSDAY_hero-temp.jpg?auto=compress&crop=focalpoint&fit=crop&fp-x=0.5&fp-y=0.5&h=1440&q=80&w=1080","altText":"AVENGERS: DOOMSDAY"},"posterImages":[{"uri":"https://img-assets.drafthouse.com/images/shows/avengers-doomsday/AVENGERS-DOOMSDAY_sp-poster-updated-copy.jpg?auto=compress&fit=clip&h=1620&q=80&w=1080","altText":"AVENGERS: DOOMSDAY"}],"additionalStillImages":[],"trailer":{"image":{"uri":"https://img-assets.drafthouse.com/images/shows/avengers-doomsday/AVENGERS-DOOMSDAY_hero-temp.jpg?auto=compress&crop=focalpoint&fit=crop&fp-x=0.5&fp-y=0.5&h=1080&q=80&w=1920","altText":"AVENGERS: DOOMSDAY"},"source":"youtube","videoUri":"https://www.youtube.com/watch?v=irVNGjRFZGk"},"runtimeMinutes":null,"nationalReleaseDateUtc":"2026-12-18","imdbId":null,"movieXchangeId":null,"certification":"PG-13","genres":[],"languages":[],"actors":[],"directors":[],"producers":[],"writers":[],"distributor